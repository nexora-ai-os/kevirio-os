# Browser-public Supabase configuration. Never place service-role credentials in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Server-only controlled OpenAI sandbox. Keep disabled until Owner configuration and smoke approval.
OPENAI_API_KEY=
KEVIRIO_OPENAI_SANDBOX_ENABLED=false
KEVIRIO_ALLOWED_ORIGIN=http://127.0.0.1:5173

# Optional server-only Provider candidates. Presence does not enable execution.
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Provider Cost Guard. All execution switches default to false when omitted.
EXTERNAL_EXECUTION_ENABLED=false
OPENAI_EXECUTION_ENABLED=false
ANTHROPIC_EXECUTION_ENABLED=false
GEMINI_EXECUTION_ENABLED=false
PERPLEXITY_EXECUTION_ENABLED=false
CANVA_EXECUTION_ENABLED=false
AI_MAX_COST_PER_REQUEST_JPY=0
AI_HOURLY_BUDGET_JPY=0
AI_DAILY_BUDGET_JPY=0
AI_MONTHLY_BUDGET_JPY=0
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_TOTAL_TOKENS=4800
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:5173
GOOGLE_OAUTH_ENABLED=false
CANVA_OAUTH_ENABLED=false
GOOGLE_GMAIL_READ_ENABLED=false
GOOGLE_DRIVE_READ_ENABLED=false
GOOGLE_CALENDAR_READ_ENABLED=false
GOOGLE_ANALYTICS_READ_ENABLED=false
GOOGLE_SEARCH_CONSOLE_READ_ENABLED=false
GOOGLE_YOUTUBE_READ_ENABLED=false
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_YOUTUBE_CHANNEL_ID=

VITE_DEVELOPER_MODE=false
