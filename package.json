{
  "name": "kevirio-os",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:full": "node --env-file-if-exists=.env.local server/localDevServer.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "node scripts/check-source-policy.mjs",
    "typecheck": "node scripts/check-javascript-syntax.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test:smoke": "node scripts/verify-authenticated-sandbox-transaction.mjs",
    "verify:legacy": "node scripts/run-legacy-verification.mjs",
    "verify:security": "node scripts/check-source-policy.mjs && node scripts/verify-credential-boundary.mjs && node scripts/verify-credential-exposure.mjs",
    "verify:migrations": "node scripts/verify-production-foundation-migration.mjs",
    "audit:env": "node scripts/check-env.mjs",
    "audit:providers": "node scripts/provider-audit.mjs",
    "audit:providers:write": "node scripts/provider-audit.mjs --write",
    "audit:providers:health": "node --env-file-if-exists=.env.local scripts/provider-health-check.mjs --live --output provider-health.json",
    "verify:provider-audit": "node scripts/verify-provider-audit.mjs",
    "verify:cost-guard": "node --test tests/unit/provider-cost-guard.test.mjs tests/unit/provider-gateway.test.mjs tests/integration/provider-cost-guard-foundation.test.mjs",
    "verify:provider-platform": "node --test tests/unit/provider-platform.test.mjs tests/unit/provider-oauth-runtime.test.mjs tests/integration/provider-platform-foundation.test.mjs",
    "verify:ai-employees": "node --test tests/unit/ai-employee-platform.test.mjs tests/integration/ai-employee-platform-foundation.test.mjs",
    "verify:migration:012": "node scripts/validate-migration-012-static.mjs",
    "verify:migration:013": "node scripts/validate-migration-013-static.mjs",
    "test:browser:auth": "playwright test --project=auth --headed",
    "test:browser": "playwright test --project=chromium",
    "test:browser:routes": "playwright test tests/browser/routes.spec.mjs --project=chromium",
    "test:browser:responsive": "playwright test tests/browser/responsive.spec.mjs --project=chromium",
    "test:browser:accessibility": "playwright test tests/browser/accessibility.spec.mjs --project=chromium",
    "test:browser:motion": "playwright test tests/browser/motion.spec.mjs --project=chromium",
    "test:browser:data-truth": "playwright test tests/browser/data-truth.spec.mjs --project=chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "6.0.3",
    "vite": "8.1.3"
  }
}
